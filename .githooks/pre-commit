#!/bin/sh
# Private configurations and credentials are local-only: never stage, commit,
# or push. The name of a file is the stable contract, so the primary rule is a
# path blocklist. Content scanning is deliberately narrow: a real age secret key
# has no fixture lookalike, and a token-bearing URL is checked only inside the
# component package, where a private template could otherwise be smuggled in.
set -u

paths=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$paths" ] || exit 0

status=0

private=$(printf '%s\n' "$paths" | grep -Ei \
  '(^|/)(F50[^/]*|Tailscale|Sparkle|Bettbox|Egern[^/]*)\.ya?ml$|(^|/)private-download/|(^|/)identity\.txt$|(^|/)subscription_urls\.txt$|(^|/)Tools/template(\.base)?\.ya?ml$|^Proxy/config\.ya?ml$' || true)
if [ -n "$private" ]; then
  printf 'pre-commit: private configuration must stay local:\n%s\n' "$private" >&2
  status=1
fi

for path in $paths; do
  case "$path" in
    reports/*|*.zip|*.png|*.gz|*.bin) continue ;;
  esac
  if git show ":$path" 2>/dev/null | grep -Eq 'AGE-SECRET-KEY-1[0-9A-Z]{58}'; then
    printf 'pre-commit: age private key in %s\n' "$path" >&2
    status=1
  fi
done

case "$paths" in
  *tproxy-yq.zip*)
    tmp=$(mktemp) || exit 1
    git show ":tproxy-yq.zip" >"$tmp" 2>/dev/null
    py=$(command -v python3 || command -v python || true)
    if [ -n "$py" ]; then
      if ! "$py" - "$tmp" <<'PY'
import re, sys, zipfile
want = ('Tools/template.yaml', 'Tools/template.base.yaml', 'Proxy/config.yaml')
bad = []
with zipfile.ZipFile(sys.argv[1]) as z:
    for name in want:
        try:
            text = z.read(name).decode('utf-8', 'replace')
        except KeyError:
            continue
        if re.search(r'AGE-SECRET-KEY-1[0-9A-Z]{58}', text) or re.search(r'[?&]token=[0-9A-Za-z]{12,}', text):
            bad.append(name)
if bad:
    sys.stderr.write('pre-commit: unredacted values in package members: %s\n' % ', '.join(bad))
    sys.exit(1)
PY
      then
        status=1
      fi
    else
      printf 'pre-commit: no python found, package members were not inspected\n' >&2
    fi
    rm -f "$tmp"
    ;;
esac

[ "$status" -eq 0 ] || printf 'pre-commit: commit refused (see above).\n' >&2
exit "$status"
