+func TestDownloadPolicy(t *testing.T) {
+	c := secureClient()
+	tr := c.Transport.(*http.Transport)
+	if tr.Proxy != nil || tr.TLSClientConfig.InsecureSkipVerify || !tr.DisableCompression || c.Timeout <= 0 {
+		t.Fatal("unsafe transport")
