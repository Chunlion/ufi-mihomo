new file mode 100644
index 0000000..f9e3515
--- /dev/null
+++ b/gist-sync/native/sealed.go
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+package main
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"time"
+)
+
+// One-use transport keys live outside config exports and component backups.
+func (a *App) requestKey() (map[string]any, error) {
+	lock, e := lockFile(a.runtime() + "/sealed.lock")
+	if e != nil {
+		return nil, e
+	}
+	defer lock.Close()
+	dir := a.runtime() + "/requests"
+	if e := privateDir(dir); e != nil {
+		return nil, e
+	}
+	entries, e := os.ReadDir(dir)
+	if e != nil {
+		return nil, e
+	}
+	count := 0
+	for _, entry := range entries {
+		info, e := entry.Info()
+		if e != nil {
+			return nil, e
+		}
+		if time.Since(info.ModTime()) > 2*time.Minute {
+			if e = secureRemove(dir + "/" + entry.Name()); e != nil {
+				return nil, e
+			}
+		} else {
+			count++
+		}
+	}
+	if count >= 8 {
+		return nil, fail("operation_busy")
+	}
+	key, e := rsa.GenerateKey(rand.Reader, 2048)
+	if e != nil {
+		return nil, e
+	}
+	id := nonce()
+	if e = atomicWrite(dir+"/"+id, x509.MarshalPKCS1PrivateKey(key), 0600); e != nil {
+		return nil, e
+	}
+	return map[string]any{"ok": true, "protocol": 1, "id": id, "modulus": fmt.Sprintf("%x", key.N), "exponent": key.E}, nil
+}
+
+type sealedRequest struct {
+	Protocol int    `json:"protocol"`
+	ID       string `json:"id"`
+	Key      string `json:"key"`
+	IV       string `json:"iv"`
+	Data     string `json:"data"`
+	MAC      string `json:"mac"`
+}
+
+func (a *App) openRequest(input io.Reader, action string) (Request, error) {
+	var req Request
+	b, e := io.ReadAll(io.LimitReader(input, 48<<10+1))
+	if e != nil || len(b) > 48<<10 {
+		return req, fail("sealed_request_invalid")
+	}
+	var env sealedRequest
+	d := json.NewDecoder(bytes.NewReader(b))
+	d.DisallowUnknownFields()
+	if d.Decode(&env) != nil || d.Decode(new(any)) != io.EOF || env.Protocol != 1 || !idRE.MatchString(env.ID) {
+		return req, fail("sealed_request_invalid")
+	}
+	lock, e := lockFile(a.runtime() + "/sealed.lock")
+	if e != nil {
+		return req, e
+	}
+	defer lock.Close()
+	path := a.runtime() + "/requests/" + env.ID
+	info, e := os.Lstat(path)
+	if e != nil {
+		return req, fail("request_key_expired")
+	}
+	raw, e := readFile(path, 4096)
+	if e != nil {
+		return req, e
+	}
+	// Remove before decoding: replay and malformed envelopes cannot reuse this key.
+	if e = os.Remove(path); e != nil {
+		return req, fail("request_key_cleanup_failed")
+	}
+	if time.Since(info.ModTime()) > 2*time.Minute || info.Mode().Perm() != 0600 {
+		return req, fail("request_key_expired")
+	}
+	private, e := x509.ParsePKCS1PrivateKey(raw)
+	if e != nil {
+		return req, fail("sealed_request_invalid")
+	}
+	wrapped, e := base64.StdEncoding.DecodeString(env.Key)
+	if e != nil {
+		return req, fail("sealed_request_invalid")
+	}
+	secret, e := rsa.DecryptOAEP(sha256.New(), rand.Reader, private, wrapped, []byte("Maomao-GistSync-RC3"))
+	if e != nil || len(secret) != 64 {
+		return req, fail("sealed_request_invalid")
+	}
+	defer func() {
+		for i := range secret {
+			secret[i] = 0
+		}
+	}()
+	iv, e := base64.StdEncoding.DecodeString(env.IV)
+	if e != nil || len(iv) != aes.BlockSize {
+		return req, fail("sealed_request_invalid")
+	}
+	data, e := base64.StdEncoding.DecodeString(env.Data)
+	if e != nil || len(data) == 0 || len(data)%aes.BlockSize != 0 {
+		return req, fail("sealed_request_invalid")
+	}
+	mac, e := base64.StdEncoding.DecodeString(env.MAC)
+	if e != nil {
+		return req, fail("sealed_request_invalid")
+	}
+	auth := hmac.New(sha256.New, secret[32:])
+	auth.Write([]byte("1\n" + env.ID + "\n" + action + "\n" + env.Key + "\n" + env.IV + "\n" + env.Data))
+	if !hmac.Equal(mac, auth.Sum(nil)) {
+		return req, fail("sealed_request_invalid")
+	}
+	block, e := aes.NewCipher(secret[:32])
+	if e != nil {
+		return req, e
+	}
+	cipher.NewCBCDecrypter(block, iv).CryptBlocks(data, data)
+	pad := int(data[len(data)-1])
+	if pad < 1 || pad > aes.BlockSize || !bytes.Equal(data[len(data)-pad:], bytes.Repeat([]byte{byte(pad)}, pad)) {
+		return req, fail("sealed_request_invalid")
+	}
+	plain := data[:len(data)-pad]
+	defer func() {
+		for i := range data {
+			data[i] = 0
+		}
+	}()
+	if len(plain) > int(maxRequest) {
+		return req, fail("request_json_invalid")
+	}
+	d = json.NewDecoder(bytes.NewReader(plain))
+	d.DisallowUnknownFields()
+	if d.Decode(&req) != nil || d.Decode(new(any)) != io.EOF {
+		return Request{}, fail("request_json_invalid")
+	}
+	return req, nil
+}
diff --git a/gist-sync/native/sealed_test.go b/gist-sync/native/sealed_test.go
new file mode 100644
index 0000000..fc9620e
--- /dev/null
+++ b/gist-sync/native/sealed_test.go
@@ -0,0 +1,103 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+)
+
+func sealedFixture(t *testing.T, a *App, action string, req Request) []byte {
+	t.Helper()
+	key, e := a.requestKey()
+	if e != nil {
+		t.Fatal(e)
+	}
+	c := exec.Command("node", "tests/gist-sync/seal-request.js")
+	c.Dir = "../.."
+	c.Stdin = bytes.NewReader(jsonBytes(map[string]any{"key": key, "action": action, "request": req}))
+	b, e := c.Output()
+	if e != nil {
+		t.Fatal("browser crypto bridge failed", e)
+	}
+	if req.Identity != "" && bytes.Contains(b, []byte(req.Identity)) {
+		t.Fatal("plaintext in transport")
+	}
+	return b
+}
+func TestSealedRequests(t *testing.T) {
+	for _, interval := range []int{1, 6, 12, 24} {
+		a := fixture(t)
+		auto := true
+		req := Request{URL: goodURL, Identity: fixtureKey, IntervalHours: &interval, Auto: &auto}
+		b := sealedFixture(t, a, "save", req)
+		got, e := a.openRequest(bytes.NewReader(b), "save")
+		if e != nil || !bytes.Equal(jsonBytes(got), jsonBytes(req)) {
+			t.Fatal("round trip", e)
+		}
+		_, e = a.openRequest(bytes.NewReader(b), "save")
+		if code(e) != "request_key_expired" {
+			t.Fatal("replay", e)
+		}
+	}
+	for _, what := range []string{"action", "ciphertext", "key", "mac", "expiry", "permissions", "unknown_field", "oversized"} {
+		t.Run(what, func(t *testing.T) {
+			a := fixture(t)
+			b := sealedFixture(t, a, "save", Request{Identity: fixtureKey})
+			action := "save"
+			var v map[string]any
+			json.Unmarshal(b, &v)
+			switch what {
+			case "action":
+				action = "delete"
+			case "ciphertext":
+				v["data"] = "AAAAAAAAAAAAAAAAAAAAAA=="
+			case "key":
+				v["key"] = "AAAA"
+			case "mac":
+				v["mac"] = "AAAA"
+			case "expiry":
+				p := a.runtime() + "/requests/" + str(v["id"])
+				old := time.Now().Add(-3 * time.Minute)
+				os.Chtimes(p, old, old)
+			case "permissions":
+				os.Chmod(a.runtime()+"/requests/"+str(v["id"]), 0644)
+			case "unknown_field":
+				v["identity"] = fixtureKey
+			case "oversized":
+				v["data"] = strings.Repeat("A", 50<<10)
+			}
+			_, e := a.openRequest(bytes.NewReader(jsonBytes(v)), action)
+			if e == nil {
+				t.Fatal("accepted invalid envelope")
+			}
+		})
+	}
+}
+func TestSealedKeyPermissionsAndExpiryCleanup(t *testing.T) {
+	a := fixture(t)
+	key, e := a.requestKey()
+	if e != nil {
+		t.Fatal(e)
+	}
+	p := a.runtime() + "/requests/" + str(key["id"])
+	info, e := os.Stat(p)
+	if e != nil || info.Mode().Perm() != 0600 {
+		t.Fatal("private key permissions", e)
+	}
+	dir, _ := os.Stat(a.runtime() + "/requests")
+	if dir.Mode().Perm() != 0700 {
+		t.Fatal("private directory permissions")
+	}
+	old := time.Now().Add(-3 * time.Minute)
+	os.Chtimes(p, old, old)
+	if _, e = a.requestKey(); e != nil || exists(p) {
+		t.Fatal("expired key cleanup", e)
+	}
+	if validAction("install-age") {
+		t.Fatal("standalone install still enabled")
+	}
+}
diff --git a/gist-sync/native/settings.go b/gist-sync/native/settings.go
new file mode 100644
index 0000000..367e411
--- /dev/null
+++ b/gist-sync/native/settings.go
@@ -0,0 +1,424 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+package main
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+type Settings struct {
+	Version       int         `json:"version"`
+	Revision      uint64      `json:"revision"`
+	Generation    string      `json:"generation"`
+	URL           string      `json:"url"`
+	Auto          bool        `json:"auto"`
+	IntervalHours int         `json:"intervalHours"`
+	SavedAt       time.Time   `json:"savedAt"`
+	Baseline      Fingerprint `json:"baseline"`
+	Deleted       bool        `json:"deleted,omitempty"`
+}
+type Request struct {
+	URL           string       `json:"url"`
+	Identity      string       `json:"identity"`
+	Auto          *bool        `json:"auto,omitempty"`
+	IntervalHours *int         `json:"intervalHours,omitempty"`
+	Revision      *uint64      `json:"revision,omitempty"`
+	ReplaceLocal  bool         `json:"replaceLocal,omitempty"`
+	ExpectedLocal *Fingerprint `json:"expectedLocal,omitempty"`
+}
+type Outcome struct {
+	OK              bool        `json:"ok"`
+	Code            string      `json:"code"`
+	Generation      string      `json:"generation,omitempty"`
+	Downloaded      bool        `json:"downloaded"`
+	Decrypted       bool        `json:"decrypted"`
+	Validated       bool        `json:"validated"`
+	Written         bool        `json:"written"`
+	Loaded          bool        `json:"loaded"`
+	RuntimeVerified bool        `json:"runtimeVerified"`
+	Saved           bool        `json:"settingsSaved,omitempty"`
+	CipherHash      string      `json:"cipherHash,omitempty"`
+	CandidateHash   string      `json:"candidateHash,omitempty"`
+	Applied         Fingerprint `json:"applied,omitempty"`
+	CompletedAt     time.Time   `json:"completedAt"`
+	Warning         string      `json:"warning,omitempty"`
+}
+type State struct {
+	Generation    string      `json:"generation"`
+	LastChecked   time.Time   `json:"lastChecked"`
+	LastSuccess   time.Time   `json:"lastSuccess"`
+	CandidateHash string      `json:"candidateHash"`
+	CipherHash    string      `json:"cipherHash"`
+	Applied       Fingerprint `json:"applied"`
+	Last          Outcome     `json:"last"`
+}
+
+func (a *App) settingsPath() string { return a.data() + "/settings.conf" }
+func (a *App) readSettings() (Settings, error) {
+	var s Settings
+	e := readJSON(a.settingsPath(), &s)
+	if os.IsNotExist(e) {
+		return Settings{Version: 1, IntervalHours: 6}, nil
+	}
+	if e != nil {
+		return s, fail("settings_unreadable")
+	}
+	if s.Version != 1 || !idRE.MatchString(s.Generation) {
+		return s, fail("settings_invalid")
+	}
+	switch s.IntervalHours {
+	case 1, 6, 12, 24:
+	default:
+		return s, fail("settings_invalid")
+	}
+	if !s.Deleted {
+		if _, _, e = validateURL(s.URL); e != nil {
+			return s, e
+		}
+	}
+	return s, nil
+}
+func (a *App) identity(s Settings) (string, error) {
+	if s.Deleted || !idRE.MatchString(s.Generation) {
+		return "", fail("age_identity_missing")
+	}
+	b, e := readFile(a.data()+"/sources/"+s.Generation+"/identity.txt", 512)
+	if e != nil {
+		return "", fail("age_identity_missing")
+	}
+	key := strings.TrimSpace(string(b))
+	if !keyRE.MatchString(key) {
+		return "", fail("invalid_age_identity")
+	}
+	return key, nil
+}
+func (a *App) snapshot() (Settings, string, error) {
+	lock, e := lockFile(a.runtime() + "/settings.lock")
+	if e != nil {
+		return Settings{}, "", e
+	}
+	defer lock.Close()
+	s, e := a.readSettings()
+	if e != nil {
+		return s, "", e
+	}
+	if s.Generation == "" || s.Deleted {
+		return s, "", nil
+	}
+	key, e := a.identity(s)
+	return s, key, e
+}
+func (a *App) readStateChecked() (State, error) {
+	var s State
+	e := readJSON(a.data()+"/state.json", &s)
+	if os.IsNotExist(e) {
+		return s, nil
+	}
+	if e != nil {
+		return s, fail("sync_state_unreadable")
+	}
+	return s, nil
+}
+func (a *App) readState() State { s, _ := a.readStateChecked(); return s }
+func (a *App) recordAttempt(generation string, out Outcome) error {
+	lock, e := lockFile(a.runtime() + "/state.lock")
+	if e != nil {
+		return e
+	}
+	defer lock.Close()
+	active, e := a.readSettings()
+	if e != nil {
+		return e
+	}
+	if active.Generation != generation || active.Deleted {
+		return nil
+	}
+	s, e := a.readStateChecked()
+	if e != nil {
+		return e
+	}
+	if s.Generation != generation {
+		s = State{Generation: generation}
+	}
+	s.LastChecked = time.Now().UTC()
+	s.Last = out
+	return writeJSON(a.data()+"/state.json", s)
+}
+func (a *App) finishState(out Outcome) error {
+	if e := a.point("state_write"); e != nil {
+		return e
+	}
+	lock, e := lockFile(a.runtime() + "/state.lock")
+	if e != nil {
+		return e
+	}
+	defer lock.Close()
+	s := State{Generation: out.Generation, LastChecked: out.CompletedAt, LastSuccess: out.CompletedAt, CandidateHash: out.CandidateHash, CipherHash: out.CipherHash, Applied: out.Applied, Last: out}
+	return writeJSON(a.data()+"/state.json", s)
+}
+func (a *App) validateSave(ctx context.Context, req Request, save bool) (out Outcome, err error) {
+	old, oldKey, e := a.snapshot()
+	if e != nil {
+		return out, e
+	}
+	if req.Revision != nil && *req.Revision != old.Revision {
+		return out, fail("settings_changed")
+	}
+	u, _, e := validateURL(strings.TrimSpace(req.URL))
+	if e != nil {
+		return out, e
+	}
+	key := strings.TrimSpace(req.Identity)
+	if key == "" {
+		key = oldKey
+	}
+	if !keyRE.MatchString(key) {
+		return out, fail("invalid_age_identity")
+	}
+	next := old
+	next.Version = 1
+	next.URL = u
+	next.Deleted = false
+	if req.Auto != nil {
+		next.Auto = *req.Auto
+	}
+	if req.IntervalHours != nil {
+		next.IntervalHours = *req.IntervalHours
+	}
+	switch next.IntervalHours {
+	case 1, 6, 12, 24:
+	default:
+		return out, fail("invalid_sync_interval")
+	}
+	sameSource := old.Generation != "" && !old.Deleted && old.URL == u && oldKey == key
+	work, e := a.newWork("validate-")
+	if e != nil {
+		return out, e
+	}
+	defer func() {
+		if e := secureRemove(work); e != nil {
+			out.Warning = "private_work_cleanup_failed"
+			out.OK = false
+			if err == nil {
+				err = e
+			}
+		}
+	}()
+	var plain string
+	// Changing scheduling on an already validated source also works while offline.
+	if !save || !sameSource {
+		if e = a.space(); e != nil {
+			return out, e
+		}
+		cipher, e := a.download(ctx, u)
+		if e != nil {
+			return out, e
+		}
+		out.Downloaded = true
+		out.CipherHash = hashBytes(cipher)
+		plain, e = a.decrypt(ctx, cipher, key, work)
+		if e != nil {
+			return out, e
+		}
+		out.Decrypted = true
+	}
+	lease, e := a.acquireLease(ctx, false)
+	if e != nil {
+		return out, e
+	}
+	defer func() {
+		if e := lease.Release(); e != nil {
+			if out.Saved {
+				out.Warning = "settings_saved_lease_cleanup_failed"
+			}
+			out.OK = false
+			if err == nil {
+				err = e
+			}
+		}
+	}()
+	sl, e := lockFile(a.runtime() + "/settings.lock")
+	if e != nil {
+		return out, e
+	}
+	defer sl.Close()
+	current, e := a.readSettings()
+	if e != nil {
+		return out, e
+	}
+	if current.Revision != old.Revision || current.Generation != old.Generation {
+		return out, fail("settings_changed")
+	}
+	if exists(a.data() + "/activation") {
+		return out, fail("config_transaction_pending")
+	}
+	if plain != "" {
+		_, hash, e := a.candidate(ctx, plain, work)
+		if e != nil {
+			return out, e
+		}
+		out.Validated = true
+		out.CandidateHash = hash
+	}
+	if !save {
+		out.OK = true
+		out.Code = "test_passed"
+		out.Generation = old.Generation
+		return out, nil
+	}
+	if e = lease.Check(); e != nil {
+		return out, e
+	}
+	if e = a.editBoot(true); e != nil {
+		return out, e
+	}
+	if !sameSource {
+		next.Generation = nonce()
+		next.Baseline, e = a.fingerprint(ctx)
+		if e != nil {
+			return out, e
+		}
+		dir := a.data() + "/sources/" + next.Generation
+		if e = privateDir(dir); e != nil {
+			return out, e
+		}
+		if e = atomicWrite(dir+"/identity.txt", []byte(key+"\n"), 0600); e != nil {
+			return out, e
+		}
+	}
+	next.Revision = old.Revision + 1
+	next.SavedAt = time.Now().UTC()
+	if e = a.point("settings_write"); e != nil {
+		return out, e
+	}
+	e = writeJSON(a.settingsPath(), next)
+	if e != nil {
+		check, re := a.readSettings()
+		if re == nil && check.Revision == next.Revision && check.Generation == next.Generation {
+			out.Saved = true
+			out.Warning = "settings_saved_durability_unconfirmed"
+		}
+		return out, e
+	}
+	out.Saved = true
+	out.Generation = next.Generation
+	out.Code = "settings_saved"
+	out.OK = true
+	// Readers snapshot identities before releasing settings.lock.
+	entries, _ := os.ReadDir(a.data() + "/sources")
+	for _, entry := range entries {
+		if idRE.MatchString(entry.Name()) && entry.Name() != next.Generation {
+			if e = secureRemove(a.data() + "/sources/" + entry.Name()); e != nil {
+				out.Warning = "old_identity_cleanup_failed"
+			}
+		}
+	}
+	return out, nil
+}
+func (a *App) disableAuto(ctx context.Context) (out Outcome, err error) {
+	lease, e := a.acquireLease(ctx, false)
+	if e != nil {
+		return out, e
+	}
+	defer func() {
+		if e := lease.Release(); err == nil && e != nil {
+			err = e
+			out.OK = false
+		}
+	}()
+	lock, e := lockFile(a.runtime() + "/settings.lock")
+	if e != nil {
+		return out, e
+	}
+	defer lock.Close()
+	s, e := a.readSettings()
+	if e != nil {
+		return out, e
+	}
+	if s.Generation == "" || s.Deleted {
+		out.OK = true
+		out.Code = "not_configured"
+		return out, nil
+	}
+	s.Auto = false
+	s.Revision++
+	s.SavedAt = time.Now().UTC()
+	if e = writeJSON(a.settingsPath(), s); e != nil {
+		return out, e
+	}
+	out.Saved = true
+	out.Generation = s.Generation
+	out.OK = true
+	out.Code = "auto_disabled"
+	return out, nil
+}
+func (a *App) deleteSettings(ctx context.Context) (out Outcome, err error) {
+	lease, e := a.acquireLease(ctx, false)
+	if e != nil {
+		return out, e
+	}
+	defer func() {
+		if e := lease.Release(); err == nil && e != nil {
+			err = e
+			out.OK = false
+		}
+	}()
+	lock, e := lockFile(a.runtime() + "/settings.lock")
+	if e != nil {
+		return out, e
+	}
+	defer lock.Close()
+	if exists(a.data() + "/activation") {
+		return out, fail("config_transaction_pending")
+	}
+	s, e := a.readSettings()
+	if e != nil {
+		return out, e
+	}
+	s = Settings{Version: 1, Revision: s.Revision + 1, Generation: nonce(), Deleted: true, IntervalHours: 6, SavedAt: time.Now().UTC()}
+	if e = writeJSON(a.settingsPath(), s); e != nil {
+		return out, e
+	}
+	out.Saved = true
+	if e = a.stopDaemon(ctx); e != nil {
+		return out, e
+	}
+	if e = a.stopOtherJobs(ctx); e != nil {
+		return out, e
+	}
+	for _, name := range []string{"sources", "work", "state.json", "yq-runtime"} {
+		if e = secureRemove(filepath.Join(a.data(), name)); e != nil {
+			return out, e
+		}
+	}
+	// Completed receipts contain no key; delete request spools and old result history as well.
+	entries, _ := os.ReadDir(a.data() + "/jobs")
+	for _, entry := range entries {
+		if strings.HasPrefix(entry.Name(), currentJobID+".") {
+			continue
+		}
+		if e = secureRemove(a.data() + "/jobs/" + entry.Name()); e != nil {
+			return out, e
+		}
+	}
+	for _, pattern := range []string{"activation.done.*", "activation.new.*"} {
+		paths, _ := filepath.Glob(a.data() + "/" + pattern)
+		for _, p := range paths {
+			if e = secureRemove(p); e != nil {
+				return out, e
+			}
+		}
+	}
+	if e = a.clearRetainedIdentities(); e != nil {
+		return out, e
+	}
+	if e = a.editBoot(false); e != nil {
+		return out, e
+	}
+	out.OK = true
+	out.Code = "sync_settings_deleted"
+	return out, nil
+}
diff --git a/gist-sync/native/transaction.go b/gist-sync/native/transaction.go
new file mode 100644
index 0000000..9437cf4
--- /dev/null
+++ b/gist-sync/native/transaction.go
@@ -0,0 +1,468 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+package main
+
+import (
+	"context"
+	"os"
+	"strings"
+	"time"
+)
+
+type Journal struct {
+	Version       int         `json:"version"`
+	ID            string      `json:"id"`
+	Generation    string      `json:"generation"`
+	Boot          string      `json:"boot"`
+	Phase         string      `json:"phase"`
+	HadSource     bool        `json:"hadSource"`
+	Running       bool        `json:"running"`
+	Before        Fingerprint `json:"before"`
+	CandidateHash string      `json:"candidateHash"`
+	Result        Outcome     `json:"result"`
+}
+
+func (a *App) journalDir() string { return a.data() + "/activation" }
+func (a *App) journal() (Journal, error) {
+	var j Journal
+	if e := noLinks(a.journalDir()); e != nil {
+		return j, e
+	}
+	if e := readJSON(a.journalDir()+"/journal.json", &j); e != nil {
+		return j, fail("activation_journal_unreadable")
+	}
+	if j.Version != 1 || !idRE.MatchString(j.ID) || !idRE.MatchString(j.Generation) {
+		return j, fail("activation_journal_invalid")
+	}
+	switch j.Phase {
+	case "prepared", "written", "verified":
+	default:
+		return j, fail("activation_journal_invalid")
+	}
+	b, e := readFile(a.journalDir()+"/id", 64)
+	if e != nil || strings.TrimSpace(string(b)) != j.ID {
+		return j, fail("activation_journal_invalid")
+	}
+	return j, nil
+}
+func (a *App) writeJournal(j Journal) error { return writeJSON(a.journalDir()+"/journal.json", j) }
+func (a *App) makeJournal(s Settings, before Fingerprint, hash string, running bool) (Journal, error) {
+	j := Journal{Version: 1, ID: nonce(), Generation: s.Generation, Boot: bootID(), Phase: "prepared", Before: before, CandidateHash: hash, Running: running}
+	tmp := a.data() + "/activation.new." + j.ID
+	if exists(a.journalDir()) {
+		return j, fail("config_transaction_pending")
+	}
+	if e := privateDir(tmp); e != nil {
+		return j, e
+	}
+	defer secureRemove(tmp)
+	if e := copyPrivate(a.cfg(), tmp+"/config.yaml"); e != nil {
+		return j, e
+	}
+	if exists(a.source()) {
+		j.HadSource = true
+		if e := copyPrivate(a.source(), tmp+"/source.conf"); e != nil {
+			return j, e
+		}
+	}
+	if e := atomicWrite(tmp+"/id", []byte(j.ID+"\n"), 0600); e != nil {
+		return j, e
+	}
+	if e := writeJSON(tmp+"/journal.json", j); e != nil {
+		return j, e
+	}
+	if e := os.Rename(tmp, a.journalDir()); e != nil {
+		return j, e
+	}
+	return j, dirSync(a.data())
+}
+func (a *App) cleanJournal() error {
+	if e := a.point("finalize"); e != nil {
+		return e
+	}
+	done := a.data() + "/activation.done." + nonce()
+	if e := os.Rename(a.journalDir(), done); e != nil {
+		return e
+	}
+	if e := dirSync(a.data()); e != nil {
+		return e
+	}
+	if e := secureRemove(done); e != nil {
+		return fail("completed_journal_cleanup_failed")
+	}
+	return dirSync(a.data())
+}
+func (a *App) rollback(ctx context.Context, l *Lease, j Journal, stopped bool) error {
+	if e := l.Check(); e != nil {
+		return e
+	}
+	if e := a.recoverGeneric(ctx, l); e != nil {
+		return e
+	}
+	current, e := a.fingerprint(ctx)
+	if e != nil {
+		return e
+	}
+	if current.Config != j.Before.Config && current.Config != j.CandidateHash {
+		return fail("rollback_external_config_conflict")
+	}
+	if current.Policy != j.Before.Policy {
+		return fail("rollback_policy_conflict")
+	}
+	stage := a.journalDir() + "/restore.yaml"
+	if e := copyPrivate(a.journalDir()+"/config.yaml", stage); e != nil {
+		return e
+	}
+	if e := a.testCore(ctx, stage); e != nil {
+		return fail("rollback_config_invalid")
+	}
+	source := ""
+	if j.HadSource {
+		source = a.journalDir() + "/source.conf"
+	}
+	if e := a.commitPair(ctx, l, stage, source, !j.HadSource, false, false, j.ID); e != nil {
+		return fail("rollback_write_failed")
+	}
+	restored, e := a.fingerprint(ctx)
+	if e != nil || restored != j.Before {
+		return fail("rollback_verification_failed")
+	}
+	if j.Running && !stopped {
+		m, e := a.readYAML(ctx, a.cfg())
+		if e != nil {
+			return e
+		}
+		pid, e := a.corePID()
+		if e != nil {
+			return e
+		}
+		if pid == 0 {
+			if e = a.service(ctx, l, j.ID, "start"); e != nil {
+				return fail("rollback_start_failed")
+			}
+		}
+		if e = a.applyRuntime(ctx, l, j.ID, m); e != nil {
+			return fail("rollback_runtime_unverified")
+		}
+	}
+	return a.cleanJournal()
+}
+func (a *App) recoverActivation(ctx context.Context, l *Lease, stopped bool) (Outcome, error) {
+	var out Outcome
+	if !exists(a.journalDir()) {
+		out.OK = true
+		out.Code = "no_transaction_pending"
+		return out, nil
+	}
+	j, e := a.journal()
+	if e != nil {
+		return out, e
+	}
+	if e = a.recoverGeneric(ctx, l); e != nil {
+		return out, e
+	}
+	if j.Phase == "verified" {
+		fp, e := a.fingerprint(ctx)
+		if e != nil {
+			return out, e
+		}
+		if fp != j.Result.Applied {
+			return j.Result, fail("committed_config_changed")
+		}
+		// A verified marker survives status/receipt loss. Do not reload or undo it.
+		out = j.Result
+		if e = a.finishState(out); e != nil {
+			out.OK = false
+			out.Code = "committed_pending_finalize"
+			return out, e
+		}
+		if e = a.cleanJournal(); e != nil {
+			out.OK = false
+			out.Code = "committed_pending_finalize"
+			return out, e
+		}
+		out.Code = "commit_finalized"
+		return out, nil
+	}
+	if e = a.rollback(ctx, l, j, stopped); e != nil {
+		return out, e
+	}
+	out.OK = true
+	out.Code = "interrupted_transaction_restored"
+	out.Generation = j.Generation
+	return out, nil
+}
+func (a *App) syncConfig(ctx context.Context, req Request, automatic bool) (out Outcome, err error) {
+	// A lost success receipt is reconciled before another download or configuration write.
+	if exists(a.journalDir()) {
+		l, e := a.acquireLease(ctx, false)
+		if e != nil {
+			return out, e
+		}
+		sl, e := lockFile(a.runtime() + "/settings.lock")
+		if e != nil {
+			_ = l.Release()
+			return out, e
+		}
+		out, e = a.recoverActivation(ctx, l, false)
+		sl.Close()
+		re := l.Release()
+		if re != nil {
+			return out, re
+		}
+		if e != nil || out.Code == "commit_finalized" {
+			return out, e
+		}
+	}
+	s, key, e := a.snapshot()
+	if e != nil {
+		return out, e
+	}
+	if s.Generation == "" || s.Deleted {
+		return out, fail("not_configured")
+	}
+	out.Generation = s.Generation
+	if automatic && !s.Auto {
+		return out, fail("auto_disabled")
+	}
+	defer func() {
+		out.CompletedAt = time.Now().UTC()
+		if err != nil && out.Code == "" {
+			out.Code = code(err)
+		}
+		if !out.OK || out.Code == "up_to_date" {
+			_ = a.recordAttempt(s.Generation, out)
+		}
+	}()
+	if e = a.space(); e != nil {
+		return out, e
+	}
+	work, e := a.newWork("sync-")
+	if e != nil {
+		return out, e
+	}
+	defer func() {
+		if e := secureRemove(work); e != nil {
+			out.Warning = "private_work_cleanup_failed"
+			out.OK = false
+			if err == nil {
+				err = e
+			}
+		}
+	}()
+	cipher, e := a.download(ctx, s.URL)
+	if e != nil {
+		return out, e
+	}
+	out.Downloaded = true
+	out.CipherHash = hashBytes(cipher)
+	if e = a.point("download_complete"); e != nil {
+		return out, e
+	}
+	plain, e := a.decrypt(ctx, cipher, key, work)
+	key = ""
+	if e != nil {
+		return out, e
+	}
+	out.Decrypted = true
+	if e = a.point("decrypt_complete"); e != nil {
+		return out, e
+	}
+	if e = a.point("after_download"); e != nil {
+		return out, e
+	}
+	l, e := a.acquireLease(ctx, false)
+	if e != nil {
+		return out, e
+	}
+	defer func() {
+		if e := l.Release(); e != nil {
+			out.OK = false
+			out.Warning = "lease_cleanup_unverified"
+			if err == nil {
+				err = e
+			}
+		}
+	}()
+	sl, e := lockFile(a.runtime() + "/settings.lock")
+	if e != nil {
+		return out, e
+	}
+	defer sl.Close()
+	active, e := a.readSettings()
+	if e != nil {
+		return out, e
+	}
+	if active.Generation != s.Generation || active.Deleted {
+		return out, fail("source_changed")
+	}
+	if automatic && !active.Auto {
+		return out, fail("auto_disabled")
+	}
+	if exists(a.journalDir()) {
+		return out, fail("config_transaction_pending")
+	}
+	if exists(a.cfg()+".kano_tx") || exists(a.Root+"/Tools/template.yaml.kano_tx") || exists(a.Root+"/Tools/template.base.yaml.kano_tx") {
+		return out, fail("config_transaction_pending")
+	}
+	pid, e := a.corePID()
+	if e != nil {
+		return out, e
+	}
+	if automatic && (pid == 0 || exists(a.Root+"/Policy/stopped")) {
+		return out, fail("auto_paused_core_stopped")
+	}
+	before, e := a.fingerprint(ctx)
+	if e != nil {
+		return out, e
+	}
+	state, e := a.readStateChecked()
+	if e != nil {
+		return out, e
+	}
+	baseline := s.Baseline
+	if state.Generation == s.Generation && state.Applied.Config != "" {
+		baseline = state.Applied
+	}
+	out.Applied = before
+	if before != baseline {
+		if automatic || !req.ReplaceLocal || req.ExpectedLocal == nil || *req.ExpectedLocal != before {
+			return out, fail("local_config_conflict")
+		}
+	}
+	candidate, hash, e := a.candidate(ctx, plain, work)
+	if e != nil {
+		return out, e
+	}
+	out.Validated = true
+	out.CandidateHash = hash
+	after, e := a.fingerprint(ctx)
+	if e != nil {
+		return out, e
+	}
+	if after != before {
+		return out, fail("local_config_changed")
+	}
+	source, _ := readFile(a.source(), 4096)
+	if before.Config == hash && strings.TrimSpace(string(source)) == "KANO_CONFIG_SOURCE=uploaded_config" {
+		if pid != 0 {
+			m, e := a.readYAML(ctx, a.cfg())
+			if e != nil {
+				return out, e
+			}
+			if e = a.runtimeVerify(ctx, m); e != nil {
+				return out, e
+			}
+			if e = a.service(ctx, l, "", "policy", "verify"); e != nil {
+				return out, e
+			}
+			out.Loaded = true
+			out.RuntimeVerified = true
+		}
+		out.OK = true
+		out.Code = "up_to_date"
+		out.CompletedAt = time.Now().UTC()
+		if e = a.finishState(out); e != nil {
+			out.OK = false
+			return out, e
+		}
+		return out, nil
+	}
+	if e = l.Check(); e != nil {
+		return out, e
+	}
+	j, e := a.makeJournal(s, before, hash, pid != 0)
+	if e != nil {
+		return out, e
+	}
+	committedVerified := false
+	defer func() {
+		if err == nil || committedVerified {
+			return
+		}
+		// Cancellation by emergency recovery is a fence, not permission to restore network rules.
+		if e := l.Check(); e != nil {
+			out.Warning = "recovery_required"
+			return
+		}
+		rctx, cancel := context.WithTimeout(context.Background(), 150*time.Second)
+		defer cancel()
+		if e := a.rollback(rctx, l, j, false); e != nil {
+			out.Warning = code(e)
+		} else {
+			out.Warning = "old_config_restored"
+		}
+	}()
+	if e = a.point("before_commit"); e != nil {
+		return out, e
+	}
+	if e = a.commitPair(ctx, l, candidate, "", false, true, true, j.ID); e != nil {
+		return out, e
+	}
+	out.Written = true
+	j.Phase = "written"
+	if e = a.writeJournal(j); e != nil {
+		return out, e
+	}
+	if e = a.point("after_commit"); e != nil {
+		return out, e
+	}
+	m, e := a.readYAML(ctx, a.cfg())
+	if e != nil {
+		return out, e
+	}
+	if canonical(m) != hash {
+		return out, fail("committed_candidate_mismatch")
+	}
+	if pid != 0 {
+		if e = a.applyRuntime(ctx, l, j.ID, m); e != nil {
+			return out, e
+		}
+		out.Loaded = true
+		out.RuntimeVerified = true
+	}
+	if e = l.Check(); e != nil {
+		return out, e
+	}
+	out.Applied, e = a.fingerprint(ctx)
+	if e != nil {
+		return out, e
+	}
+	if out.Applied.Config != hash || out.Applied.Policy != before.Policy {
+		return out, fail("runtime_changed_candidate")
+	}
+	out.OK = true
+	out.Code = "synced"
+	if pid == 0 {
+		out.Code = "saved_stopped"
+	}
+	out.CompletedAt = time.Now().UTC()
+	j.Phase = "verified"
+	j.Result = out
+	if e = a.writeJournal(j); e != nil {
+		// A rename may have committed even when directory fsync reports failure.
+		read, re := a.journal()
+		if re == nil && read.Phase == "verified" {
+			committedVerified = true
+			out.Code = "committed_pending_finalize"
+			out.OK = false
+		}
+		return out, e
+	}
+	committedVerified = true
+	if e = a.point("before_state_record"); e != nil {
+		out.OK = false
+		out.Code = "committed_pending_finalize"
+		return out, e
+	}
+	if e = a.finishState(out); e != nil {
+		out.OK = false
+		out.Code = "committed_pending_finalize"
+		return out, e
+	}
+	if e = a.cleanJournal(); e != nil {
+		out.OK = false
+		out.Code = "committed_pending_finalize"
+		return out, e
+	}
+	return out, nil
+}
