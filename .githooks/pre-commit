#!/bin/sh
# Private configurations and credentials are local-only: never stage, commit,
# or push. The name of a file is the stable contract, so the primary rule is a
# path blocklist. Content scanning checks age private keys; token-bearing URLs
# are checked only inside component package templates.
set -u

git diff --cached --quiet --diff-filter=ACMR && exit 0

status=0

set --
for extension in yaml yml; do
  for name in 'F50*' Tailscale Sparkle Bettbox 'Egern*'; do
    set -- "$@" ":(icase,glob)**/$name.$extension"
  done
  set -- "$@" ":(icase,glob)**/Tools/template.$extension" \
    ":(icase,glob)**/Tools/template.base.$extension" ":(icase,glob)Proxy/config.$extension"
done
set -- "$@" ':(icase,glob)**/private-download/**' \
  ':(icase,glob)**/identity.txt' ':(icase,glob)**/subscription_urls.txt'
private=$(git diff --cached --name-only --diff-filter=ACMR -- "$@")
if [ -n "$private" ]; then
  printf 'pre-commit: private configuration must stay local:\n%s\n' "$private" >&2
  status=1
fi

# Scan staged additions for plaintext age private keys. Only added lines can
# introduce a key (removed lines are cleanups and must pass), and any scanner
# failure must refuse the commit instead of counting as "no key found".
tmp=$(mktemp) || exit 1
if ! git diff --cached --diff-filter=ACMR -U0 >"$tmp"; then
  rm -f "$tmp"
  printf 'pre-commit: cannot inspect staged changes; refusing commit\n' >&2
  exit 1
fi
keys=$(awk '
  /^diff --git / { name = "" }
  /^\+\+\+ / { name = substr($0, 7) }
  /^\+/ && $0 !~ /^\+\+\+/ && /AGE-SECRET-KEY-1[0-9A-Z]{58}/ && name != "" && !seen[name]++ { print name }
' "$tmp")
rc=$?
rm -f "$tmp"
if [ "$rc" -ge 2 ]; then
  printf 'pre-commit: age key scan failed (awk exit %s); refusing commit\n' "$rc" >&2
  status=1
elif [ -n "$keys" ]; then
  printf 'pre-commit: age private key in staged files:\n%s\n' "$keys" >&2
  status=1
fi

if ! git diff --cached --quiet --diff-filter=ACMR -- tproxy-yq.zip; then
    tmp=$(mktemp) || exit 1
    git show ":tproxy-yq.zip" >"$tmp" 2>/dev/null
    py=$(command -v python3 || command -v python || true)
    if [ -n "$py" ]; then
      if ! "$py" - "$tmp" <<'PY'
import re, sys, zipfile
want = ('Tools/template.yaml', 'Tools/template.base.yaml', 'Proxy/config.yaml')
bad = []
with zipfile.ZipFile(sys.argv[1]) as z:
    for name in want:
        try:
            text = z.read(name).decode('utf-8', 'replace')
        except KeyError:
            continue
        if re.search(r'AGE-SECRET-KEY-1[0-9A-Z]{58}', text) or re.search(r'''[?&][a-z_]*token[a-z_]*=[^\s&#'"<>]+''', text, re.I):
            bad.append(name)
if bad:
    sys.stderr.write('pre-commit: unredacted values in package members: %s\n' % ', '.join(bad))
    sys.exit(1)
PY
      then
        status=1
      fi
    else
      printf 'pre-commit: no python found; cannot inspect package members\n' >&2
      status=1
    fi
    rm -f "$tmp"
fi

[ "$status" -eq 0 ] || printf 'pre-commit: commit refused (see above).\n' >&2
exit "$status"
