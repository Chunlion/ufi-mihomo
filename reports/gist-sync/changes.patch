+		args, e := os.ReadFile(fmt.Sprintf("/proc/%d/cmdline", pid))
+		if e != nil {
+			return 0, fail("core_state_unreadable")
+		}
+		test := false
+		for _, arg := range strings.Split(string(args), "\x00") {
+			if arg == "-t" || arg == "--test" {
+				test = true
+			}
+		}
+		if test {
+			continue
+		}
+		if found != 0 {
+			return 0, fail("multiple_core_processes")
+		}
