+			m := regexp.MustCompile(`[vV]([0-9]+)\.([0-9]+)\.([0-9]+)`).FindSubmatch(v)
+			modern := false
+			if len(m) == 4 {
+				a, _ := strconv.Atoi(string(m[1]))
+				b, _ := strconv.Atoi(string(m[2]))
+				c, _ := strconv.Atoi(string(m[3]))
