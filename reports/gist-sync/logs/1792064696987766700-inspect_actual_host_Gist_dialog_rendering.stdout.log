      return {\r\n            el: toastEl,\r\n            close: () => {\r\n                toastEl.style.opacity = `0`\r\n                toastEl.style.transform = `scale(0)`\r\n                toastEl.style.top = '-' + toastEl.getBoundingClientRect().height + 'px'\r\n                clearTimeout(timer)\r\n                timer = setTimeout(() => {\r\n                    toastEl.remove()\r\n                }, 300);\r\n            }\r\n        }\r\n    } catch (e) {\r\n        console.error('创建toast失败:', e);\r\n    }\r\n}"}},"status":"succeeded","transition":{"closedPages":[],"documentGeneration":4,"openedPages":[],"pageCount":1,"targetEpoch":7,"url":"http://192.168.0.1:2333/","urlChanged":false}}
